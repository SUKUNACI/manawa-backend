# Copiez ce fichier en .env et remplissez les valeurs

# Base de données PostgreSQL (Neon, Supabase, Railway...)
DATABASE_URL="postgresql://user:password@localhost:5432/btpconnect"

# Secret pour signer les tokens JWT (générez une chaîne aléatoire longue)
JWT_SECRET="changez-moi-avec-une-cle-longue-et-aleatoire"

# GeniusPay - Paiements mobiles et carte bancaire en Afrique
# Créez un compte sur https://geniuspay.ci puis récupérez ces identifiants
# dans votre tableau de bord (Paramètres > API)
GENIUSPAY_API_KEY="pk_sandbox_xxxxxxxx"
GENIUSPAY_API_SECRET="sk_sandbox_xxxxxxxx"
GENIUSPAY_WEBHOOK_SECRET="whsec_sandbox_xxxxxxxx"

# Optionnel: ancien système de paiement (gardez pour compatibilité)
# CINETPAY_API_KEY="votre-api-key-cinetpay"
# CINETPAY_SITE_ID="votre-site-id-cinetpay"

# URL publique de votre backend (celle donnée par ngrok en test,
# ou votre vrai domaine une fois déployé) - SANS slash à la fin
BACKEND_PUBLIC_URL="https://votre-adresse-ngrok.ngrok-free.dev"

PORT=4000

# Email (optionnel en test - si non configuré, les codes s'affichent dans l'app au lieu d'être envoyés)
# Avec Gmail : activez la validation en 2 étapes puis créez un "mot de passe d'application"
# sur https://myaccount.google.com/apppasswords
EMAIL_USER="votre-adresse@gmail.com"
EMAIL_PASSWORD="votre-mot-de-passe-application"

# SMS Twilio (optionnel en test - si non configuré, les codes s'affichent dans l'app)
# Créez un compte gratuit sur https://www.twilio.com
TWILIO_ACCOUNT_SID="votre-account-sid"
TWILIO_AUTH_TOKEN="votre-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
