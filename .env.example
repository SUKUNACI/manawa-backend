# Copiez ce fichier en .env et remplissez les valeurs

# Base de données PostgreSQL (Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/manawa"

# Secret JWT (chaîne aléatoire longue)
JWT_SECRET="changez-moi-avec-une-cle-longue-et-aleatoire"

# Port
PORT=4000

# Origines autorisées CORS (séparées par virgule, ou * pour tout autoriser)
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# URL publique du backend (Railway URL en prod, ngrok en dev)
BACKEND_PUBLIC_URL="https://votre-url.up.railway.app"

# Cloudinary — stockage fichiers
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# Mailjet — envoi d'emails
MAILJET_API_KEY="votre-api-key"
MAILJET_SECRET_KEY="votre-secret-key"
MAILJET_FROM_EMAIL="noreply@votre-domaine.com"
MAILJET_FROM_NAME="MANAWA"

# GeniusPay — paiements mobiles
GENIUSPAY_API_KEY="pk_sandbox_xxxxxxxx"
GENIUSPAY_API_SECRET="sk_sandbox_xxxxxxxx"
GENIUSPAY_WEBHOOK_SECRET="whsec_sandbox_xxxxxxxx"

# Firebase — push notifications (JSON minifié sur une ligne)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# Twilio — SMS (optionnel)
TWILIO_ACCOUNT_SID="votre-account-sid"
TWILIO_AUTH_TOKEN="votre-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
